# ------------------------------------------------------------------
# Frontend (public) Supabase credentials — anon/publishable key ONLY.
# These two are inlined into the browser bundle by design.
# ------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-or-publishable-key>

# Canonical origin used to build auth email links (invitation, password recovery).
# Never taken from a query parameter — see lib/url.ts.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ------------------------------------------------------------------
# SERVER ONLY — never prefixed with NEXT_PUBLIC_, never committed.
# Read by exactly one module, lib/supabase/admin.ts, which starts with
# `import "server-only"`. Used only to send the invitation email for an
# address the database has already authorised.
#
# Put the project's SECRET api key here:
#   * new-style projects:    sb_secret_...        (preferred — independently revocable)
#   * legacy projects:       the service_role JWT
# One variable, either value. Do not define a second name.
# ------------------------------------------------------------------
# SUPABASE_SECRET_KEY=<server-only secret key>
